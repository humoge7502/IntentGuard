# IntentGuard — example environment configuration
# Copy to .env and adjust. NEVER commit real secrets.

# --- Store -----------------------------------------------------------
# memory | sqlite | postgres
INTENTGUARD_STORE=sqlite
# For sqlite (path relative to backend working dir):
INTENTGUARD_SQLITE_PATH=./data/intentguard.db
# For postgres:
# INTENTGUARD_DATABASE_URL=postgresql+psycopg://intentguard:CHANGE_ME@localhost:5432/intentguard

# --- API -------------------------------------------------------------
INTENTGUARD_HOST=127.0.0.1
INTENTGUARD_PORT=8400
# Comma-separated origins allowed to call the API from a browser
INTENTGUARD_CORS_ORIGINS=http://127.0.0.1:8400,http://localhost:8400
# Rate limit: requests per minute per API key
INTENTGUARD_RATE_LIMIT_PER_MIN=600

# --- Audit signing (optional) ---------------------------------------
# If set, audit chain events are Ed25519-signed. Generate with:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; import base64; k=Ed25519PrivateKey.generate(); print(base64.b64encode(k.private_bytes(Encoding,NonFormat,NoEncryption())).decode())"
# Leave empty to run with the (tamper-evident) hash chain only.
INTENTGUARD_AUDIT_SIGNING_KEY=

# --- Bootstrap -------------------------------------------------------
# On first start, seed a bootstrap admin API key and print it once.
INTENTGUARD_BOOTSTRAP_ADMIN=1
